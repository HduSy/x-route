{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "x-route",
    "main": "./worker.ts",
    "compatibility_date": "2026-09-01",
    "assets": {
        "directory": "./dist",
        // SPA: unknown paths fall back to index.html
        "not_found_handling": "single-page-application",
        // Route to the worker so GeoIP redirection, /api/*, /r/*, and the
        // Tianditu key HTML injection run; assets stream from env.ASSETS.fetch().
        // NOTE: narrowing this (e.g. ["/api/*"]) silently bypasses the worker
        // for asset-matched paths — that killed geo-redirect, /r/ handling,
        // and key injection when it shipped on 2026-10-09.
        "run_worker_first": true,
        "binding": "ASSETS"
    },
    "vars": {
        // Geo routing: CN visitors → x-route.cn, everyone else → x-route.app.
        // ICP filing completed 2026-10; flip to "false" as a kill switch.
        "ENABLE_CN_REDIRECT": "true",
        "CN_TARGET_DOMAIN": "x-route.cn"
    },
    "kv_namespaces": [
        {
            // Route sharing store: key = 6-char base62, value = gzip'd GPX bytes,
            // TTL 1 day (links are a delivery channel, not permanent storage).
            "binding": "ROUTE_SHARES",
            "id": "f36453794f1d4b9bbe206eaf1fd79bf8"
        }
    ],
    "routes": [
        { "pattern": "x-route.app", "custom_domain": true },
        { "pattern": "www.x-route.app", "custom_domain": true },
        { "pattern": "x-route.cn", "custom_domain": true },
        { "pattern": "www.x-route.cn", "custom_domain": true }
    ]
}
